{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "formatter": true,
  "model": "opencode/gemini-3.5-flash",
  "small_model": "opencode/gemini-3-flash",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
